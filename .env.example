APP_ENV=development
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@localhost:5432/crypto_ai

# Safety defaults
LIVE_TRADING=false
PAPER_TRADING=true
ENABLE_WORKERS=false
SINGLE_OPERATOR_MODE=false
BROKER=binance
LIVE_TRADING_CONFIRM=

# Authentication / encryption
JWT_SECRET_KEY=replace-with-a-random-32-plus-character-secret
CREDENTIAL_VAULT_KEY=

# Per-user broker credentials are stored encrypted in the app vault.
# These env credentials are only a deliberate single-operator fallback.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true

# AI - providers are tried left-to-right; missing/failed providers are skipped.
AI_PROVIDER_FALLBACKS=groq,gemini,openrouter,openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_NEWS_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Clawtrade companion agent (analysis/backtesting only; live execution remains disabled)
CLAWTRADE_ENABLED=false
CLAWTRADE_BASE_URL=http://clawtrade:8899
CLAWTRADE_API_TOKEN=
CLAWTRADE_TIMEOUT_SECONDS=10

# Notifications — optional, fail-safe when unset
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_TIMEOUT_SECONDS=5

# Risk
AUTO_OPPORTUNITY_ENABLED=false
AUTO_OPPORTUNITY_MAX_USDT=10
DEFAULT_STOP_LOSS_PERCENT=5
DEFAULT_TAKE_PROFIT_PERCENT=5

# Exchange/network
BINANCE_RECV_WINDOW_MS=5000
EXCHANGE_HTTP_TIMEOUT=10
FX_HTTP_TIMEOUT=10

# Dashboard / workers
WATCHLIST_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
MARKET_STREAM_SYMBOLS=BTCUSDT,ETHUSDT
CORS_ORIGINS=http://localhost:3000
NEWS_FEEDS=
